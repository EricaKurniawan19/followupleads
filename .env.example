# Capsule CRM — My Preferences → API Authentication Tokens
CAPSULE_API_TOKEN=

# Google Calendar OAuth — create credentials in Google Cloud Console
# (OAuth client, type "Desktop app" works fine), then run:
#   npm run get-google-token
# to mint GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Comma-separated calendar IDs to check (each must be a calendar your Google
# account has at least read access to). Defaults to just "primary" if unset.
# Useful when meetings get organized on a colleague's calendar you can view.
GOOGLE_CALENDAR_IDS=primary,admin@oxbridge-econ.com

# Comma-separated personal contacts to never treat as leads, even though
# they're "external" by domain (e.g. family/friends on a shared calendar).
GOOGLE_CALENDAR_EXCLUDE_EMAILS=

# If set, only count a meeting as a lead when this address is an
# attendee/organizer AND there's an external attendee too — filters out
# other internal meetings that happen to have an unrelated external guest.
GOOGLE_CALENDAR_REQUIRE_ATTENDEE=admin@oxbridge-econ.com

# Attendees on this domain are treated as internal — meetings where every
# attendee is internal are excluded from calendar sync.
COMPANY_DOMAIN=oxbridge-econ.com

# Days after a meeting a follow-up is due, for newly synced/added leads.
FOLLOW_UP_DAYS=7

# Where the JSON store lives. Relative paths resolve from the project root.
DATA_FILE=./data/leads.json

# Standard 5-field cron expression for the background scheduler (bin/serve.js, bin/schedule.js).
SYNC_CRON=0 7,15 * * *

PORT=3000

# Set to "true" to run the web server without the built-in scheduler
# (e.g. if sync is instead driven by GitHub Actions / external cron via `npm run sync`).
DISABLE_SCHEDULER=false

# Optional — if set, `npm run sync` posts a digest (new + overdue leads) to this Slack webhook.
SLACK_WEBHOOK_URL=

# Optional — only needed when hosting on a platform with an ephemeral disk
# (e.g. Render's free tier). If both are set, every write is also committed
# and pushed to this repo, so a restart re-clones the latest data instead of
# losing edits made through the web UI. GITHUB_TOKEN needs `repo` scope.
GITHUB_TOKEN=
GITHUB_REPO=EricaKurniawan19/followupleads
