# Capsule CRM — My Preferences → API Authentication Tokens
CAPSULE_API_TOKEN=

# Google Calendar OAuth — create credentials in Google Cloud Console
# (OAuth client, type "Desktop app" works fine), then run:
#   npm run get-google-token
# to mint GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Attendees on this domain are treated as internal — meetings where every
# attendee is internal are excluded from calendar sync.
COMPANY_DOMAIN=oxbridge-econ.com

# Days after a meeting a follow-up is due, for newly synced/added leads.
FOLLOW_UP_DAYS=7

# Where the JSON store lives. Relative paths resolve from the project root.
DATA_FILE=./data/leads.json

# Standard 5-field cron expression for the background scheduler (bin/serve.js, bin/schedule.js).
SYNC_CRON=0 7,15 * * *

PORT=3000

# Set to "true" to run the web server without the built-in scheduler
# (e.g. if sync is instead driven by GitHub Actions / external cron via `npm run sync`).
DISABLE_SCHEDULER=false

# Optional — if set, `npm run sync` posts a digest (new + overdue leads) to this Slack webhook.
SLACK_WEBHOOK_URL=
